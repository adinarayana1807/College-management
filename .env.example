# Example environment variables for College-management (RAG skeleton)
# Copy to .env and fill values before running in production

# LLM and embeddings provider: 'local' or 'openai' (default local)
LLM_PROVIDER=local

# If using OpenAI, set the key here
OPENAI_API_KEY=

# JWT secret key
SECRET_KEY=change-this-to-a-secure-random-value

# Chroma / Vector store path (used by config default)
CHROMA_PERSIST_DIR=backend/vector_db/chroma_db

# SQLite DB (optional)
DATABASE_URL=sqlite:///backend/database/college_rag.db
