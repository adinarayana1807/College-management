# LLM Provider: "gemini" (recommended), "openai", or "local" (zero-key fallback)
LLM_PROVIDER=gemini

# ==========================================
# MongoDB Configuration (Optional)
# ==========================================
# For local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=college_rag_db

# Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG Hyperparameters
CHUNK_SIZE=600
CHUNK_OVERLAP=120
DEFAULT_TOP_K=4
SIMILARITY_THRESHOLD=0.25

# Admin Credentials
DEFAULT_ADMIN_EMAIL=admin@college.edu
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_NAME=College Administrator
